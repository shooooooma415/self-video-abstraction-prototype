{
  "name": "self-video-abstraction-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:parity": "vite --config parity/vite.config.ts --host 0.0.0.0",
    "build:parity": "vite build --config parity/vite.config.ts",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "depth:bridge": "sh scripts/run-depth-bridge.sh"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "@pixiv/three-vrm": "^3.5.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
